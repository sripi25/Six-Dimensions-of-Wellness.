    var l=dimLevel(sc[i]);
    return '<div class="row"><div class="top"><h3>'+(i+1)+". "+d.n+'</h3><span><b>'+sc[i]+'</b>/20 <span class="chip lv'+l.k+'">'+l.t+'</span></span></div>'
     +'<div class="bar" aria-hidden="true"><i style="width:'+(sc[i]/20*100)+'%;background:var('+d.c+')"></i></div><div class="muted">'+l.m+'</div>'+tipHtml(i,sc[i])+'</div>';
  }).join("");
  var order=sc.map(function(v,i){return i}).sort(function(a,b){return sc[a]-sc[b]||a-b}).slice(0,2);
  var best=Math.max.apply(null,sc),bi=sc.indexOf(best);
  var f='<h2>มิติที่ควรโฟกัส</h2>';
  if(sc[order[0]]>=17){
    f+='<p>ทุกมิติอยู่ในระดับดีมาก ลองเลือก 1 มิติที่คะแนนต่ำที่สุดมาตั้งเป้าหมายเล็กๆ เพื่อรักษาความสมดุลต่อไป: <b>'+DIMS[order[0]].n+'</b> ('+sc[order[0]]+'/20)</p>';
  } else {
    f+='<p>มิติที่ได้คะแนนต่ำสุด 2 มิติ คือ</p>';
    order.forEach(function(i){var l=dimLevel(sc[i]);f+='<p><b>'+DIMS[i].n+'</b> '+sc[i]+'/20 <span class="chip lv'+l.k+'">'+l.t+'</span> – '+l.m+'</p>';});
    f+='<p class="muted">ลองนำไปตั้งเป้าหมายเล็กๆ ในตารางแผนพัฒนาตนเองด้านล่าง</p>';
  }
  f+='<p style="margin:0">จุดแข็งที่สุดของคุณ คือ <b>'+DIMS[bi].n+'</b> ('+best+'/20)</p>';
  $("focus").innerHTML=f;
  var pl=[];sc.forEach(function(v,i){if(v<17)pl.push(i);});pl.sort(function(a,b){return sc[a]-sc[b]||a-b;});
  if(!pl.length){$("plan").innerHTML='<p>ทุกมิติอยู่ในระดับดีมาก จึงไม่จำเป็นต้องตั้งเป้าหมายเพิ่ม ลองรักษาพฤติกรรมที่ทำอยู่ต่อไป</p>';}
  else{$("plan").innerHTML='<div style="overflow-x:auto"><table style="min-width:480px"><tr><th>มิติที่ต้องการพัฒนา</th><th>เป้าหมายเล็กๆ ที่ทำได้จริง</th><th>ระยะเวลา</th></tr>'
    +pl.map(function(i){var l=dimLevel(sc[i]);return '<tr data-n="'+DIMS[i].n+' ('+sc[i]+'/20)"><td><b>'+DIMS[i].n+'</b><br><span class="muted">'+sc[i]+'/20 – '+l.t+'</span></td><td><input class="t" aria-label="เป้าหมาย '+DIMS[i].n+'"></td><td><input class="t" aria-label="ระยะเวลา '+DIMS[i].n+'"></td></tr>';}).join("")
    +'</table></div><p class="muted" style="margin-top:8px">ข้อมูลที่กรอกในตารางนี้ไม่ถูกบันทึก หากต้องการเก็บไว้ให้บันทึกเป็น PDF หรือรูปภาพก่อนปิดหน้านี้</p>';}
  LAST={sc:sc,tot:tot,order:order,best:bi};
  show("result");
}
</script>
</body>
</html>
